# Backend only. Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Disposable database for pytest only (never the demo database). Optional.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qeleme_test

# Any OpenAI-compatible chat API that supports tool calling.
# Test with: python -m app.check_ai
# Hackathon setup: OpenRouter, free models only (ids end in ":free").
# 1. Make a key at https://openrouter.ai/keys   2. Run: python -m app.check_ai   3. Paste a model it approves below.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace_me
AI_MODEL=replace_with_a_free_model_that_passes_check_ai
# Other base URLs to try (confirm each in the provider's own docs):
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/

# Exact frontend origin(s), comma separated, no trailing slash, no wildcard.
ALLOWED_ORIGINS=http://localhost:5173
DAILY_RUN_CAP=40
FORCE_AI_FAILURE=


# Sign-in. AUTH_SECRET signs login tokens: use a long random string, and never commit the real one.
AUTH_SECRET=replace_with_a_long_random_string
# Used only by: python -m app.seed_users
SUPERADMIN_EMAIL=admin@qeleme.test
SUPERADMIN_PASSWORD=replace_me_before_seeding
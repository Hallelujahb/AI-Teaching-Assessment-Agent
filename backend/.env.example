# Backend only. Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any OpenAI-compatible chat API that supports tool calling.
# Test with: python -m app.check_ai
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=replace_me
AI_MODEL=replace_with_a_model_that_passes_check_ai
# Other base URLs to try (confirm each in the provider's own docs):
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/

ALLOWED_ORIGINS=http://localhost:5173
DAILY_RUN_CAP=40
FORCE_AI_FAILURE=
